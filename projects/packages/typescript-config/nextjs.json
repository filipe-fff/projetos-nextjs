{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@repo/ui/*": ["../../packages/ui/*"],
      "@repo/fonts/*": ["../../packages/fonts/*"],
      "@repo/interfaces/*": ["../../packages/interfaces/*"],
      "@repo/enums/*": ["../../packages/enums/*"],
      "@repo/utils/*": ["../../packages/utils/*"],
      "@repo/lib/*": ["../../packages/lib/*"],
      "@repo/eslint-config": ["../../packages/eslint-config"]
    }
  }
}